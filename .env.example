# Supabase / Lovable Cloud
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=

# Server-only provider token encryption. Use 64 hex characters (32 bytes).
PROVIDER_TOKEN_ENCRYPTION_KEY=

# Public HTTPS origin used in provider callback and account-link URLs.
APP_BASE_URL=https://your-domain.example

# Ring Partner API / Ring Appstore-first account linking.
# Register these URLs in the Ring Developer Portal:
#   POST ${APP_BASE_URL}/api/ring/token-exchange
#   GET  ${APP_BASE_URL}/api/ring/link
#   POST ${APP_BASE_URL}/api/ring/webhook
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SIGNING_KEY=
RING_APPSTORE_URL=
RING_API_BASE_URL=https://api.amazonvision.com
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_USER_AGENT=RecallOS/1.0

# AWS EventBridge. IAM needs events:PutEvents on the event bus.
AWS_REGION=
AWS_EVENT_BUS_NAME=
AWS_EVENT_SOURCE=recallos.ring
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Alexa Smart Home account linking.
# Register APP_BASE_URL/api/alexa/authorize as the authorization URI and
# APP_BASE_URL/api/alexa/token as the access-token URI in the Alexa Developer Console.
ALEXA_SKILL_ID=
ALEXA_SKILL_URL=
ALEXA_ACCOUNT_LINKING_CLIENT_ID=
ALEXA_ACCOUNT_LINKING_CLIENT_SECRET=
ALEXA_ALLOWED_REDIRECT_URIS=
ALEXA_TOKEN_TTL_SECONDS=3600
